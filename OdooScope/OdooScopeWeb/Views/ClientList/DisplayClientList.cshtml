@using OdooScopeEntities.Entities;
@model List<Client>

<h1>Liste des clients</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <td scope="col">Id</td>
            <td scope="col">Nom</td>
            <td scope="col">Email</td>
            <td scope="col">NombreEmploye</td>
            <td scope="col">SecteurActivite</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Client a in Model)
        {
            <tr>
                <td scope="col">@a.Id</td>
                <td>@a.Nom</td>
                <td>@a.Email</td>
                <td>@a.NombreEmploye</td>
                <td>@a.SecteurActivite</td>
            </tr>
        }
    </tbody>
</table>
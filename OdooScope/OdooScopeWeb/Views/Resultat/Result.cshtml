@using OdooScopeEntities.Entities;
@model Resultat

<h1>Résultat</h1>

<h2>Client</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Nombre d'employés</th>
            <th>Secteur d'activité</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Client.Nom</td>
            <td>@Model.Client.Email</td>
            <td>@Model.Client.NombreEmploye</td>
            <td>@Model.Client.SecteurActivite.Nom</td>
        </tr>
    </tbody>
</table>

<h2>Applications Odoo</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Description</th>
            <th>Essentielle</th>
            <th>Administrative</th>
        </tr>
    </thead>
    <tbody>
        @foreach (CreationListe cl in (List<CreationListe>)ViewBag.Applications)
        {
            <tr>
                <td>@cl.ApplicationOdoo.Nom</td>
                <td>@cl.ApplicationOdoo.Description</td>
                <td>@(cl.ApplicationOdoo.EstEssentiel ? "Oui" : "Non")</td>
                <td>@(cl.ApplicationOdoo.EstAdministrative ? "Oui" : "Non")</td>
            </tr>
        }
    </tbody>
</table>

<h2>Notes</h2>
<form asp-controller="Resultat" asp-action="UpdateNotes" method="post">
    <textarea>@Model.Notes</textarea>
    <br />
    <input type="submit" value="Sauvegarder les notes" class="btn btn-sm btn-dark" />
</form>
<br />
<a asp-controller="MainMenu" asp-action="Menu" class="btn btn-sm btn-dark">Retour au menu</a>
@using OdooScopeEntities.Entities;
@model List<Client>

@*Liste les clients avec secteurs d'activités*@
<h1>Liste des clients</h1>

<table id="tableClients" class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nom</th>
            <th scope="col">Email</th>
            <th scope="col">Employés</th>
            <th scope="col">Secteur</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Client c in Model)
        {
            <tr>
                <td scope="col">@c.Id</td>
                <td>@c.Nom</td>
                <td>@c.Email</td>
                <td>@c.NombreEmploye</td>
                <td>@c.SecteurActivite.Nom</td>
                <td>
                    <a asp-controller="Client" asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-dark">Client</a>
                    <a asp-controller="Question" asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-dark">Question</a>
                    <a asp-controller="Resultat" asp-action="Result" asp-route-clientId="@c.Id" class="btn btn-sm btn-dark">Resultat</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@*Permet la recherche et le nombre maximum de ligne affichée*@
<script>
    $(document).ready(function () {
        var table = $('#tableClients').DataTable({
            "paging": true,
            "lengthChange": false,
            "pageLength": 25,
            "ordering": true,
            "order": [[1, "asc"]],
            "language": {
                "search": "",
                "paginate": { "previous": "Précédent", "next": "Suivant" },
                "info": "_START_ à _END_ entrée(s) sur _TOTAL_ au total",
                "infoEmpty": "Aucune entrée",
                "infoFiltered": "(filtré de _MAX_ entrées au total)",
                "zeroRecords": "Aucun enregistrement trouvé"
            },
            "dom": "<'row'<'col-md-6'l><'col-md-6 d-flex justify-content-end mb-3'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",
            "initComplete": function () {
                $(".dataTables_filter input")
                    .attr("placeholder", "Rechercher...")
                    .addClass("form-control");
            }
        });
    });
</script>
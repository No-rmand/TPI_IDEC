@using OdooScopeEntities.Entities;
@model List<Client>

<h1>Liste des clients</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <td scope="col">Id</td>
            <td scope="col">Nom</td>
            <td scope="col">Email</td>
            <td scope="col">NombreEmploye</td>
            <td scope="col">SecteurActivite</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Client c in Model)
        {
            <tr>
                <td scope="col">@c.Id</td>
                <td>@c.Nom</td>
                <td>@c.Email</td>
                <td>@c.NombreEmploye</td>
                <td>@c.SecteurActivite.Nom</td>
                <td>
                    <a asp-controller="Client" asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-dark">Client</a>
                    <a asp-controller="Question" asp-action="Update" asp-route-id="@c.Id" class="btn btn-sm btn-dark">Question</a>
                    <a asp-controller="Resultat" asp-action="Result" asp-route-clientId="@c.Id" class="btn btn-sm btn-dark">Resultat</a>
                    @*
                        Liaisons à faire vers le bon chemin
                        pour client et question = formulaire nouveau client remplis avec les infos / questionnaire avec les réponses
                        Resultat - vue des résultats du client
                    *@
                </td>
            </tr>
        }
    </tbody>
</table>
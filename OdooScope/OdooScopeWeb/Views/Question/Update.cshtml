@using OdooScopeEntities.Entities;
@using Newtonsoft.Json;
@model List<Question>

<h1>Questionnaire</h1>

<h2>Client</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Nombre d'employés</th>
            <th>Secteur d'activité</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@ViewBag.Client.Nom</td>
            <td>@ViewBag.Client.Email</td>
            <td>@ViewBag.Client.NombreEmploye</td>
            <td>@ViewBag.Client.SecteurActivite.Nom</td>
        </tr>
    </tbody>
</table>

<h2>Questions</h2>
<div class="d-flex justify-content-center gap-3 mb-3">
    <button type="button" class="btn btn-sm btn-dark" onclick="toggleFiltreOui(this)">Masquer Oui</button>
    <button type="button" class="btn btn-sm btn-dark" onclick="toggleFiltreNon(this)">Masquer Non</button>
</div>

<div class="d-flex flex-column align-items-center mt-2">
    <div style="width: 700px;">

        <div id="reponseHidden"></div>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Question</th>
                    <th scope="col" style="width: 150px; text-align: center;">Réponse</th>
                </tr>
            </thead>
            <tbody id="questionnaireJson">
            </tbody>
        </table>

        <div class="mb-4 mt-3">
            <label class="form-label">Notes</label>
            <textarea id="Notes" class="form-control" rows="3">@ViewBag.Notes</textarea>
        </div>

        <div class="d-flex justify-content-center mb-5">
            <input type="button" value="Sauver" class="btn btn-dark" style="width: 250px;" onclick="Sauver()" />
        </div>

    </div>
</div>

<script>
    var listQuestionJson = @Html.Raw(Json.Serialize(Model.Select(q => new
        {
            id = q.Id,
                texte = q.Texte,
                ordre = q.Ordre,
                questionId = q.QuestionId
        })));

    var reponsesExistantes = @Html.Raw(Json.Serialize(
                        ((List<Repondre>)ViewBag.ReponsesExistantes).Select(r => new
                    {
                                questionId = r.QuestionId,
                                reponse = r.Reponse
                    })
                ));

    var reponses = {};
    var masquerOui = false;
    var masquerNon = false;

    var questionParent = listQuestionJson.filter(q => q.questionId === null);
    questionParent.sort((a, b) => a.ordre - b.ordre);

    questionParent.forEach(q => {
        newLine(q, null);
    });

    questionParent.forEach(q => {
        if (reponses[q.id] === true) {
            questionEnfant(q.id);
        }
    });

    function newLine(question, apresElement) {
        var tbody = $("#questionnaireJson");

        var tr = $("<tr>").attr("id", "ligne-" + question.id);
        var tdTexte = $("<td>").html(question.texte);
        var tdReponse = $("<td>").css({ "text-align": "center", "white-space": "nowrap" });

        var btnOui = $("<button>")
            .attr("type", "button")
            .attr("id", "oui-" + question.id)
            .text("Oui")
            .addClass("btn btn-sm me-2");

        var btnNon = $("<button>")
            .attr("type", "button")
            .attr("id", "non-" + question.id)
            .text("Non")
            .addClass("btn btn-sm");

        btnOui.on("click", function () {
            btnOui.addClass("btn-oui-selected").removeClass("btn-selected");
            btnNon.removeClass("btn-selected btn-oui-selected");
            reponses[question.id] = true;
            questionEnfant(question.id);
            appliquerFiltres();
        });

        btnNon.on("click", function () {
            btnNon.addClass("btn-selected").removeClass("btn-oui-selected");
            btnOui.removeClass("btn-selected btn-oui-selected");
            reponses[question.id] = false;
            cacherEnfants(question.id);
            appliquerFiltres();
        });

        var reponseExistante = reponsesExistantes.find(r => r.questionId === question.id);
        if (reponseExistante && reponseExistante.reponse === true) {
            btnOui.addClass("btn-oui-selected");
            reponses[question.id] = true;
        } else {
            btnNon.addClass("btn-selected");
            reponses[question.id] = false;
        }

        tdReponse.append(btnOui).append(btnNon);
        tr.append(tdTexte).append(tdReponse);

        if (apresElement) {
            $(apresElement).after(tr);
        } else {
            tbody.append(tr);
        }
    }

    function questionEnfant(parentId) {
        var enfants = listQuestionJson.filter(q => q.questionId === parentId);
        enfants.sort((a, b) => a.ordre - b.ordre);

        var ligneReference = document.getElementById("ligne-" + parentId);

        enfants.forEach(enfant => {
            if (!document.getElementById("ligne-" + enfant.id)) {
                newLine(enfant, ligneReference);
                ligneReference = document.getElementById("ligne-" + enfant.id);
            }
            if (reponses[enfant.id] === true) {
                questionEnfant(enfant.id);
            }
        });
    }

    function cacherEnfants(parentId) {
        var enfants = listQuestionJson.filter(q => q.questionId === parentId);

        enfants.forEach(enfant => {
            cacherEnfants(enfant.id);
            delete reponses[enfant.id];
            $("#ligne-" + enfant.id).remove();
        });
    }

    function toggleFiltreOui(btn) {
        masquerOui = !masquerOui;
        btn.textContent = masquerOui ? "Afficher Oui" : "Masquer Oui";
        $(btn).toggleClass("btn-oui-selected");
        appliquerFiltres();
    }

    function toggleFiltreNon(btn) {
        masquerNon = !masquerNon;
        btn.textContent = masquerNon ? "Afficher Non" : "Masquer Non";
        $(btn).toggleClass("btn-selected");
        appliquerFiltres();
    }

    function appliquerFiltres() {
        for (var id in reponses) {
            var ligne = $("#ligne-" + id);
            if (ligne.length) {
                if (masquerOui && reponses[id] === true) {
                    ligne.hide();
                } else if (masquerNon && reponses[id] === false) {
                    ligne.hide();
                } else {
                    ligne.show();
                }
            }
        }
    }

    function Sauver() {
        var questionIds = [];
        var reponseValeurs = [];

        for (var id in reponses) {
            questionIds.push(parseInt(id));
            reponseValeurs.push(reponses[id]);
        }

        var notes = $("#Notes").val();
        var clientId = @ViewBag.ClientId;

        var jsonData = {
            "clientId": clientId,
            "notes": notes,
            "questionIds": questionIds,
            "reponses": reponseValeurs
        };

        $.ajax({
            dataType: "json",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(jsonData),
            url: "/Question/Update",
            success: function () {
                window.location.replace("/Resultat/Result?clientId=" + clientId);
            },
            error: function () {
                alert("Une erreur est survenue lors de la sauvegarde.");
            }
        });
    }
</script>
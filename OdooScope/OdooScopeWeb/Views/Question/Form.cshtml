@using OdooScopeEntities.Entities;
@model List<Question>

<h1>Questionnaire</h1>
<form asp-controller="Question" asp-action="New" method="post">
    <table class="table table-striped">
        <thead>
            <tr>
                <td scope="col">Id</td>
                <td scope="col">Texte</td>
                <td scope="col">Réponse</td>
            </tr>
        </thead>
        <tbody>
            @foreach (Question a in Model)
            {
                if (a.QuestionId != null)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>@a.Texte</td>
                        <td><button type="submit" value="true">Oui</button></td>
                        <td><button type="submit" value="false">Non</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <label>Notes</label>
    <textarea name="Notes">@ViewBag.Notes</textarea>
    <br />
    <br />
    <input type="submit" value="Sauver" class="btn btn-sm btn-dark" />
</form>
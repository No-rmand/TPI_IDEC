@using OdooScopeEntities.Entities;
@model List<Question>

<h1>Liste des Questions</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <td scope="col">Id</td>
            <td scope="col">Texte</td>
            <td scope="col">Ordre</td>
            <td scope="col">Parent</td>
        </tr>
    </thead>
    <tbody>
        @foreach (Question a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Texte</td>
                <td>@a.Ordre</td>
                <td>@a.QuestionId</td>
            </tr>
        }
    </tbody>
</table>
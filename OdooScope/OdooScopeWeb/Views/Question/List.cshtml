@using OdooScopeEntities.Entities;
@model List<Question>

@*Liste les questions*@
<h1>Liste des Questions</h1>

<table id="tableQuestions" class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Texte</th>
            <th scope="col">Ordre</th>
            <th scope="col">Parent</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Question a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Texte</td>
                <td>@a.Ordre</td>
                <td>@a.QuestionId</td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        var table = $('#tableQuestions').DataTable({
            "paging": true,
            "lengthChange": false,
            "pageLength": 25,
            "ordering": true,
            "order": [[2, "asc"]],
            "language": {
                "search": "",
                "paginate": { "previous": "Précédent", "next": "Suivant" },
                "info": "_START_ à _END_ entrée(s) sur _TOTAL_ au total",
                "infoEmpty": "Aucune entrée",
                "infoFiltered": "(filtré de _MAX_ entrées au total)",
                "zeroRecords": "Aucun enregistrement trouvé"
            },
            "dom": "<'row'<'col-md-6'l><'col-md-6 d-flex justify-content-end mb-3'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",
            "initComplete": function () {
                $(".dataTables_filter input")
                    .attr("placeholder", "Rechercher...")
                    .addClass("form-control");
            }
        });
    });
</script>
@using OdooScopeEntities.Entities;
@model List<ApplicationOdoo>

<h1>Liste des Applications Odoo</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <td scope="col">Id</td>
            <td scope="col">Nom</td>
            <td scope="col">Description</td>
            <td scope="col">Est essentielle</td>
            <td scope="col">Est administrative</td>
            <td scope="col">Secteur d'activité'</td>
            <td scope="col">Emloyé minimum</td>

        </tr>
    </thead>
    <tbody>
        @foreach (ApplicationOdoo a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Nom</td>
                <td>@a.Description</td>
                <td>@a.EstEssentiel</td>
                <td>@a.EstAdministrative</td>
                <td>@a.SecteurActivite?.Nom</td>
                <td>@a.EmployeMin</td>
            </tr>
        }
    </tbody>
</table>
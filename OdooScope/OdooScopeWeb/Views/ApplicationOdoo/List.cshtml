@using OdooScopeEntities.Entities;
@model List<ApplicationOdoo>

<h1>Liste des Applications Odoo</h1>

<table id="tableApplicationOdoo" class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nom</th>
            <th scope="col">Description</th>
            <th scope="col">Essentielle</th>
            <th scope="col">Administrative</th>
            <th scope="col">Secteur d'activité</th>
            <th scope="col">Employés min.</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ApplicationOdoo a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Nom</td>
                <td>@a.Description</td>
                <td class="text-center"><span class="@(a.EstEssentiel ? "icone-oui" : "icone-non")"></span></td>
                <td class="text-center"><span class="@(a.EstAdministrative ? "icone-oui" : "icone-non")"></span></td>
                <td>@a.SecteurActivite?.Nom</td>
                <td>@a.EmployeMin</td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        var table = $('#tableApplicationOdoo').DataTable({
            "paging": true,
            "lengthChange": false,
            "pageLength": 25,
            "ordering": true,
            "order": [[1, "asc"]],
            "language": {
                "search": "",
                "paginate": { "previous": "Précédent", "next": "Suivant" },
                "info": "_START_ à _END_ entrée(s) sur _TOTAL_ au total",
                "infoEmpty": "Aucune entrée",
                "infoFiltered": "(filtré de _MAX_ entrées au total)",
                "zeroRecords": "Aucun enregistrement trouvé"
            },
            "dom": "<'row'<'col-md-6'l><'col-md-6 d-flex justify-content-end mb-3'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",
            "initComplete": function () {
                $(".dataTables_filter input")
                    .attr("placeholder", "Rechercher...")
                    .addClass("form-control");
            }
        });
    });
</script>
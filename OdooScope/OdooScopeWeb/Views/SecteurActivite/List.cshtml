@using OdooScopeEntities.Entities;
@model List<SecteurActivite>

<h1>Liste des secteurs d'activités</h1>

<table id="tableSecteurActivite" class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nom</th>
            <th scope="col">Description</th>

        </tr>
    </thead>
    <tbody>
        @foreach (SecteurActivite a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Nom</td>
                <td>@a.Description</td>

            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        var table = $('#tableSecteurActivite').DataTable({
            "paging": true,
            "lengthChange": false,
            "pageLength": 30,
            "ordering": true,
            "order": [[0, "asc"]],
            "language": {
                "search": "",
                "paginate": { "previous": "Précédent", "next": "Suivant" },
                "info": "_START_ à _END_ entrée(s) sur _TOTAL_ au total",
                "infoEmpty": "Aucune entrée",
                "infoFiltered": "(filtré de _MAX_ entrées au total)",
                "zeroRecords": "Aucun enregistrement trouvé"
            },
            "dom": "<'row'<'col-md-6'l><'col-md-6 d-flex justify-content-end mb-3'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",
            "initComplete": function () {
                $(".dataTables_filter input")
                    .attr("placeholder", "Rechercher...")
                    .addClass("form-control");
            }
        });
    });
</script>